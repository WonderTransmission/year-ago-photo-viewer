// Shared build settings for all targets.
//
// Personal values (team, bundle ID prefix, App Group) belong in
// Local.xcconfig, which git ignores. Copy Local.xcconfig.template to start.

// Defaults, overridden by Local.xcconfig when present.
BUNDLE_ID_PREFIX = com.wondertransmission
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
APP_GROUP_ID = group.com.wondertransmission.yearago

#include? "Local.xcconfig"

// App Groups (used by the widget) need a development team. Without a team,
// build with entitlements that leave the App Group out; the widget then
// shows a setup message. SIGNING_KIND is "AdHoc" or the team ID.
SIGNING_KIND = $(DEVELOPMENT_TEAM:default=AdHoc)
APP_ENTITLEMENTS_AdHoc = App/App.entitlements
WIDGET_ENTITLEMENTS_AdHoc = Widget/Widget.entitlements
APP_ENTITLEMENTS = $(APP_ENTITLEMENTS_$(SIGNING_KIND):default=App/App+AppGroup.entitlements)
WIDGET_ENTITLEMENTS = $(WIDGET_ENTITLEMENTS_$(SIGNING_KIND):default=Widget/Widget+AppGroup.entitlements)

// Version, shared by the app and the widget.
MARKETING_VERSION = 1.3.0
CURRENT_PROJECT_VERSION = 4

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES
COPY_PHASE_STRIP = NO
